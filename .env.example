# Telegram Bot API
BOT_TOKEN=

# Telegram MTProto Assistant User Account
API_ID=
API_HASH=
ASSISTANT_SESSION=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
FFMPEG_PATH=ffmpeg
TEMP_MEDIA_DIR=./runtime/media
MAX_TRACK_DURATION_SECONDS=7200
MAX_QUEUE_SIZE=100

# Persistence
# If PostgreSQL runs on the host at port 5431:
DATABASE_URL=postgresql+asyncpg://musicbot:CHANGE_ME@127.0.0.1:5431/musicbot
# If the bot runs inside Docker Compose, use the service address instead:
# DATABASE_URL=postgresql+asyncpg://musicbot:CHANGE_ME@postgres:5432/musicbot
REDIS_URL=redis://127.0.0.1:16379/0
# Project-specific host ports; container ports remain PostgreSQL=5432 and Redis=6379
POSTGRES_HOST_PORT=5431
REDIS_HOST_PORT=16379

# Optional Web/Mini App
WEBAPP_BASE_URL=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Optional Provider metadata credentials; never commit real values
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Feature flags
ENABLE_EXTERNAL_PROVIDERS=false
ENABLE_VIDEO=false
ENABLE_MINI_APP=false
