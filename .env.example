# Telegram Bot API
BOT_TOKEN=

# Telegram MTProto Assistant User Account
API_ID=
API_HASH=
ASSISTANT_SESSION=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
FFMPEG_PATH=ffmpeg
TEMP_MEDIA_DIR=./runtime/media
MAX_TRACK_DURATION_SECONDS=7200
MAX_QUEUE_SIZE=100

# Persistence
DATABASE_URL=postgresql+asyncpg://musicbot:musicbot@localhost:5432/musicbot
REDIS_URL=redis://localhost:6379/0

# Optional Web/Mini App
WEBAPP_BASE_URL=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Optional Provider metadata credentials; never commit real values
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Feature flags
ENABLE_EXTERNAL_PROVIDERS=false
ENABLE_VIDEO=false
ENABLE_MINI_APP=false
